#include <iostream>
#include <queue>
using namespace std;

struct Node {
    int data;
    Node *left, *right;

    Node(int x) {
        data = x;
        left = right = NULL;
    }
};

class BST {
    Node *root;

public:
    BST() {
        root = NULL;
    }

    Node* insert(Node *temp, int x) {
        if (temp == NULL)
            return new Node(x);

        if (x < temp->data)
            temp->left = insert(temp->left, x);
        else if (x > temp->data)
            temp->right = insert(temp->right, x);

        return temp;
    }

    void insert(int x) {
        root = insert(root, x);
    }

    // 1. Display mirror image
    void mirror(Node *temp) {
        if (temp == NULL)
            return;

        swap(temp->left, temp->right);

        mirror(temp->left);
        mirror(temp->right);
    }

    void displayMirror() {
        mirror(root);
        levelOrder();
        mirror(root);
    }

    // 2. Create a copy
    Node* copy(Node *temp) {
        if (temp == NULL)
            return NULL;

        Node *newNode = new Node(temp->data);
        newNode->left = copy(temp->left);
        newNode->right = copy(temp->right);

        return newNode;
    }

    void createCopy() {
        Node *copyRoot = copy(root);

        cout << "Copied tree: ";
        levelOrder(copyRoot);
    }

    // 3. Delete specified node
    Node* deleteNode(Node *temp, int x) {
        if (temp == NULL)
            return NULL;

        if (x < temp->data)
            temp->left = deleteNode(temp->left, x);

        else if (x > temp->data)
            temp->right = deleteNode(temp->right, x);

        else {
            if (temp->left == NULL) {
                Node *t = temp->right;
                delete temp;
                return t;
            }

            if (temp->right == NULL) {
                Node *t = temp->left;
                delete temp;
                return t;
            }

            Node *t = temp->right;

            while (t->left != NULL)
                t = t->left;

            temp->data = t->data;
            temp->right = deleteNode(temp->right, t->data);
        }

        return temp;
    }

    void deleteNode(int x) {
        root = deleteNode(root, x);
    }

    // 4. Display tree level wise
    void levelOrder(Node *temp) {
        if (temp == NULL)
            return;

        queue<Node*> q;
        q.push(temp);

        while (!q.empty()) {
            Node *current = q.front();
            q.pop();

            cout << current->data << " ";

            if (current->left)
                q.push(current->left);

            if (current->right)
                q.push(current->right);
        }

        cout << "\n";
    }

    void levelOrder() {
        levelOrder(root);
    }
};

int main() {
    BST tree;

    tree.insert(50);
    tree.insert(30);
    tree.insert(70);
    tree.insert(20);
    tree.insert(40);
    tree.insert(60);
    tree.insert(80);

    cout << "Original tree: ";
    tree.levelOrder();

    tree.createCopy();

    cout << "Mirror tree: ";
    tree.displayMirror();

    tree.deleteNode(30);

    cout << "After deletion: ";
    tree.levelOrder();

    return 0;
}
