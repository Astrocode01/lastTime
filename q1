#include <iostream>
#include <queue>
using namespace std;

struct Node {
    int data;
    Node *left, *right;

    Node(int x) {
        data = x;
        left = right = NULL;
    }
};

class BinaryTree {
    Node *root;

public:
    BinaryTree() {
        root = NULL;
    }

    // 1. Insert + handle duplicate
    void insert(int x) {
        Node *newNode = new Node(x);

        if (root == NULL) {
            root = newNode;
            return;
        }

        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            Node *temp = q.front();
            q.pop();

            if (temp->data == x) {
                delete newNode;
                cout << "Duplicate entry not inserted\n";
                return;
            }

            if (temp->left == NULL) {
                temp->left = newNode;
                return;
            }
            else
                q.push(temp->left);

            if (temp->right == NULL) {
                temp->right = newNode;
                return;
            }
            else
                q.push(temp->right);
        }
    }

    // 2. Delete
    void deleteNode(int x) {
        if (root == NULL)
            return;

        if (root->left == NULL && root->right == NULL) {
            if (root->data == x) {
                delete root;
                root = NULL;
            }
            return;
        }

        Node *target = NULL, *last = NULL, *parent = NULL;
        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            Node *temp = q.front();
            q.pop();

            if (temp->data == x && target == NULL)
                target = temp;

            if (temp->left) {
                parent = temp;
                last = temp->left;
                q.push(temp->left);
            }

            if (temp->right) {
                parent = temp;
                last = temp->right;
                q.push(temp->right);
            }
        }

        if (target == NULL) {
            cout << "Node not found\n";
            return;
        }

        target->data = last->data;

        if (parent->right == last)
            parent->right = NULL;
        else
            parent->left = NULL;

        delete last;
    }

    // 3. Search
    void search(int x) {
        if (root == NULL) {
            cout << "Tree is empty\n";
            return;
        }

        queue<Node*> q;
        q.push(root);

        while (!q.empty()) {
            Node *temp = q.front();
            q.pop();

            if (temp->data == x) {
                cout << "Node found\n";
                return;
            }

            if (temp->left)
                q.push(temp->left);

            if (temp->right)
                q.push(temp->right);
        }

        cout << "Node not found\n";
    }

    // 4. Display tree using traversal
    void display() {
        if (root == NULL)
            return;

        cout << "Preorder: ";
        preorder(root);

        cout << "\nInorder: ";
        inorder(root);

        cout << "\nPostorder: ";
        postorder(root);

        cout << "\n";
    }

    // 5. Display depth
    int depth(Node *temp) {
        if (temp == NULL)
            return 0;

        return 1 + max(depth(temp->left), depth(temp->right));
    }

    void displayDepth() {
        cout << "Depth of tree: " << depth(root) << "\n";
    }

private:
    void preorder(Node *temp) {
        if (temp == NULL)
            return;

        cout << temp->data << " ";
        preorder(temp->left);
        preorder(temp->right);
    }

    void inorder(Node *temp) {
        if (temp == NULL)
            return;

        inorder(temp->left);
        cout << temp->data << " ";
        inorder(temp->right);
    }

    void postorder(Node *temp) {
        if (temp == NULL)
            return;

        postorder(temp->left);
        postorder(temp->right);
        cout << temp->data << " ";
    }
};

int main() {
    BinaryTree tree;

    tree.insert(10);
    tree.insert(20);
    tree.insert(30);
    tree.insert(40);
    tree.insert(50);
    tree.insert(20);

    tree.display();

    tree.search(30);
    tree.search(100);

    tree.deleteNode(20);
    tree.display();

    tree.displayDepth();

    return 0;
}
